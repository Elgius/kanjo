NEON_DB="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Optional: use an isolated Neon branch for integration tests.
# TEST_NEON_DB="postgresql://USER:PASSWORD@TEST_HOST/DATABASE?sslmode=require"
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# Bunny's S3-compatible API values from the storage bucket's S3 credentials panel.
# Keep these server-only: do not rename them with a NEXT_PUBLIC_ prefix.
BUNNY_S3_ENDPOINT=https://your-s3-endpoint.example
BUNNY_S3_REGION=your-region
BUNNY_S3_BUCKET=your-bucket
BUNNY_S3_ACCESS_KEY_ID=your-access-key-id
BUNNY_S3_SECRET_ACCESS_KEY=your-secret-access-key

# Set to false only if your endpoint requires virtual-host-style bucket URLs.
BUNNY_S3_FORCE_PATH_STYLE=true
