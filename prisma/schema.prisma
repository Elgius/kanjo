generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String              @id
  name            String
  email           String
  username        String?             @unique
  displayUsername String?
  emailVerified   Boolean             @default(false)
  image           String?
  roleId          String              @db.Uuid
  isSiteAdmin     Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  role            Role                @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions        Session[]
  accounts        Account[]
  openedShifts    RegisterShift[]     @relation("ShiftOpenedBy")
  closedShifts    RegisterShift[]     @relation("ShiftClosedBy")
  sales           Sale[]              @relation("SaleCreatedBy")
  stockChanges    InventoryMovement[]
  receivedBatches InventoryBatch[]    @relation("BatchReceivedBy")
  auditLogs       AuditLog[]          @relation("AuditActor")

  @@unique([email])
  @@index([roleId])
  @@index([isSiteAdmin])
  @@map("user")
}

enum PageKey {
  OVERVIEW
  REGISTERS
  INVENTORY
  STOCK
  REPORTING
  SETTINGS
  AUDIT_LOG
}

enum PermissionLevel {
  NONE
  VIEW
  EDIT
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}

model Role {
  id             String           @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String           @unique
  description    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  users          User[]
  permissions    RolePermission[]

  @@index([name])
  @@map("roles")
}

model RolePermission {
  roleId String          @db.Uuid
  page   PageKey
  level  PermissionLevel @default(NONE)
  role   Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, page])
  @@index([page, level])
  @@map("role_permissions")
}

model AuditLog {
  id         String       @id @default(uuid()) @db.Uuid
  occurredAt DateTime     @default(now())
  outcome    AuditOutcome
  event      String
  page       PageKey?
  actorId    String?
  actorLabel String?
  targetType String?
  targetId   String?
  summary    String
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  searchText String       @db.Text
  actor      User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([occurredAt(sort: Desc), id(sort: Desc)])
  @@index([actorId, occurredAt(sort: Desc)])
  @@index([outcome, occurredAt(sort: Desc)])
  @@index([event, occurredAt(sort: Desc)])
  @@index([page, occurredAt(sort: Desc)])
  @@index([targetType, targetId, occurredAt(sort: Desc)])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "audit_logs_search_text_trgm_idx")
  @@map("audit_logs")
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum SaleStatus {
  COMPLETED
  REFUNDED
  VOIDED
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE
}

enum InventoryMovementType {
  INITIAL
  ADJUSTMENT
  SALE
  REFUND
}

enum ProductKind {
  GOODS
  CONSUMABLE
}

enum RegisterPurpose {
  SHOP
  RESTAURANT
}

model Product {
  id                String               @id @default(uuid()) @db.Uuid
  registerId        String               @db.Uuid
  sku               String               @unique
  barcode           String?              @unique
  name              String
  category          String
  description       String?
  retailPriceLaari  Int
  costPriceLaari    Int                  @default(0)
  lowStockThreshold Int                  @default(10)
  kind              ProductKind          @default(GOODS)
  quantityMetric    String?
  quantityValue     Decimal?             @db.Decimal(12, 3)
  servingSize       Decimal?             @db.Decimal(12, 3)
  active            Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  register          CashRegister         @relation(fields: [registerId], references: [id], onDelete: Restrict)
  saleItems         SaleItem[]
  stockMovements    InventoryMovement[]
  batches           InventoryBatch[]
  menuIngredients   MenuItemIngredient[]

  @@index([active, updatedAt(sort: Desc)])
  @@index([registerId, active, name])
  @@index([category])
  @@map("products")
}

model CashRegister {
  id             String              @id @default(uuid()) @db.Uuid
  code           String              @unique
  name           String              @unique
  purpose        RegisterPurpose     @default(SHOP)
  active         Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  shifts         RegisterShift[]
  products       Product[]
  stockMovements InventoryMovement[]
  menuItems      MenuItem[]
  batches        InventoryBatch[]

  @@index([active, name])
  @@map("cash_registers")
}

model MenuItem {
  id               String               @id @default(uuid()) @db.Uuid
  registerId       String               @db.Uuid
  name             String
  category         String
  retailPriceLaari Int
  active           Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  register         CashRegister         @relation(fields: [registerId], references: [id], onDelete: Restrict)
  ingredients      MenuItemIngredient[]
  saleItems        SaleItem[]

  @@unique([registerId, name])
  @@index([registerId, active, name])
  @@map("menu_items")
}

model MenuItemIngredient {
  menuItemId        String   @db.Uuid
  productId         String   @db.Uuid
  servingMultiplier Int
  menuItem          MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([menuItemId, productId])
  @@index([productId])
  @@map("menu_item_ingredients")
}

model InventoryBatch {
  id                String       @id @default(uuid()) @db.Uuid
  productId         String       @db.Uuid
  registerId        String       @db.Uuid
  receivedById      String
  receivedQuantity  Decimal      @db.Decimal(14, 3)
  remainingQuantity Decimal      @db.Decimal(14, 3)
  expiryDate        DateTime?    @db.Date
  receivedAt        DateTime     @default(now())
  product           Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  register          CashRegister @relation(fields: [registerId], references: [id], onDelete: Restrict)
  receivedBy        User         @relation("BatchReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)

  @@index([productId, expiryDate, receivedAt])
  @@index([registerId, expiryDate])
  @@map("inventory_batches")
}

model RegisterShift {
  id               String       @id @default(uuid()) @db.Uuid
  registerId       String       @db.Uuid
  openedById       String
  closedById       String?
  status           ShiftStatus  @default(OPEN)
  openingCashLaari Int          @default(0)
  closingCashLaari Int?
  openedAt         DateTime     @default(now())
  closedAt         DateTime?
  register         CashRegister @relation(fields: [registerId], references: [id], onDelete: Restrict)
  openedBy         User         @relation("ShiftOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  closedBy         User?        @relation("ShiftClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  sales            Sale[]

  @@index([registerId, status, openedAt(sort: Desc)])
  @@index([openedById])
  @@index([closedById])
  @@map("register_shifts")
}

model Sale {
  id              String              @id @default(uuid()) @db.Uuid
  receiptNumber   BigInt              @unique @default(autoincrement())
  registerShiftId String              @db.Uuid
  createdById     String
  status          SaleStatus          @default(COMPLETED)
  paymentMethod   PaymentMethod
  subtotalLaari   Int
  totalLaari      Int
  createdAt       DateTime            @default(now())
  refundedAt      DateTime?
  registerShift   RegisterShift       @relation(fields: [registerShiftId], references: [id], onDelete: Restrict)
  createdBy       User                @relation("SaleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items           SaleItem[]
  stockMovements  InventoryMovement[]

  @@index([status, createdAt(sort: Desc)])
  @@index([registerShiftId, createdAt(sort: Desc)])
  @@index([createdById])
  @@map("sales")
}

model SaleItem {
  id             String    @id @default(uuid()) @db.Uuid
  saleId         String    @db.Uuid
  productId      String?   @db.Uuid
  menuItemId     String?   @db.Uuid
  productName    String
  productSku     String?
  itemCategory   String
  quantity       Int
  unitPriceLaari Int
  lineTotalLaari Int
  sale           Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product        Product?  @relation(fields: [productId], references: [id], onDelete: Restrict)
  menuItem       MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
  @@index([menuItemId])
  @@map("sale_items")
}

model InventoryMovement {
  id            String                @id @default(uuid()) @db.Uuid
  productId     String                @db.Uuid
  registerId    String                @db.Uuid
  saleId        String?               @db.Uuid
  createdById   String
  type          InventoryMovementType
  quantityDelta Decimal               @db.Decimal(14, 3)
  balanceAfter  Decimal               @db.Decimal(14, 3)
  reason        String?
  createdAt     DateTime              @default(now())
  product       Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  register      CashRegister          @relation(fields: [registerId], references: [id], onDelete: Restrict)
  sale          Sale?                 @relation(fields: [saleId], references: [id], onDelete: Restrict)
  createdBy     User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([productId, createdAt(sort: Desc)])
  @@index([registerId, createdAt(sort: Desc)])
  @@index([saleId])
  @@index([createdById])
  @@map("inventory_movements")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
