generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String               @id
  name               String
  email              String
  username           String?              @unique
  displayUsername    String?
  emailVerified      Boolean              @default(false)
  image              String?
  roleId             String               @db.Uuid
  isSiteAdmin        Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  role               Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions           Session[]
  accounts           Account[]
  openedShifts       RegisterShift[]      @relation("ShiftOpenedBy")
  closedShifts       RegisterShift[]      @relation("ShiftClosedBy")
  sales              Sale[]               @relation("SaleCreatedBy")
  registerOrders     RegisterOrder[]      @relation("RegisterOrderCreatedBy")
  creditBillsCreated CustomerCreditBill[] @relation("CreditBillCreatedBy")
  creditBillsSettled CustomerCreditBill[] @relation("CreditBillSettledBy")
  stockChanges       InventoryMovement[]
  receivedBatches    InventoryBatch[]     @relation("BatchReceivedBy")
  auditLogs          AuditLog[]           @relation("AuditActor")

  @@unique([email])
  @@index([roleId])
  @@index([isSiteAdmin])
  @@map("user")
}

enum PageKey {
  OVERVIEW
  REGISTERS
  INVENTORY
  STOCK
  REPORTING
  BILL_HISTORY
  CUSTOMERS
  SETTINGS
  AUDIT_LOG
}

enum PermissionLevel {
  NONE
  VIEW
  EDIT
}

enum RegisterScopeMode {
  ALL
  SELECTED
}

enum CapabilityKey {
  OVERVIEW_VIEW
  REGISTERS_VIEW
  REGISTER_ADMIN_VIEW
  REGISTER_SESSIONS_VIEW
  RESTAURANT_MENU_VIEW
  RESTAURANT_FLOOR_VIEW
  INVENTORY_VIEW
  STOCK_VIEW
  BILL_HISTORY_VIEW
  CUSTOMERS_VIEW
  CUSTOMER_CREDIT_VIEW
  REPORTING_VIEW
  SETTINGS_VIEW
  AUDIT_LOG_VIEW_ALL
  REGISTER_CREATE_GLOBAL
  REGISTER_RENAME
  REGISTER_TYPE_CHANGE
  REGISTER_ARCHIVE
  REGISTER_DELETE
  SHIFT_OPEN
  SHIFT_CLOSE
  SHIFT_OVERRIDE
  SALE_RECORD
  ORDER_HOLD
  ORDER_CANCEL
  CUSTOMER_CREDIT_ISSUE
  MENU_ITEM_CREATE
  MENU_ITEM_UPDATE
  RESTAURANT_TABLE_CREATE
  RESTAURANT_TABLE_UPDATE
  PRODUCT_CREATE
  PRODUCT_UPDATE
  PRODUCT_DELETE
  CATEGORY_CREATE_GLOBAL
  CATEGORY_UPDATE_GLOBAL
  CATEGORY_DELETE_GLOBAL
  STOCK_RECEIVE
  BATCH_EXPIRY_UPDATE
  STOCK_WRITE_OFF
  CUSTOMER_CREATE
  CUSTOMER_UPDATE
  CUSTOMER_CREDIT_LIMIT_UPDATE
  CUSTOMER_CREDIT_SETTLE
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}

model Role {
  id                String               @id @default(uuid()) @db.Uuid
  name              String
  normalizedName    String               @unique
  description       String?
  registerScopeMode RegisterScopeMode    @default(SELECTED)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  users             User[]
  permissions       RolePermission[]
  capabilities      RoleCapability[]
  registerAccess    RoleRegisterAccess[]

  @@index([name])
  @@map("roles")
}

model RoleCapability {
  roleId     String        @db.Uuid
  capability CapabilityKey
  role       Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, capability])
  @@index([capability])
  @@map("role_capabilities")
}

model RoleRegisterAccess {
  roleId     String       @db.Uuid
  registerId String       @db.Uuid
  role       Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  register   CashRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)

  @@id([roleId, registerId])
  @@index([registerId])
  @@map("role_register_access")
}

model RolePermission {
  roleId String          @db.Uuid
  page   PageKey
  level  PermissionLevel @default(NONE)
  role   Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, page])
  @@index([page, level])
  @@map("role_permissions")
}

model AuditLog {
  id         String       @id @default(uuid()) @db.Uuid
  occurredAt DateTime     @default(now())
  outcome    AuditOutcome
  event      String
  page       PageKey?
  actorId    String?
  actorLabel String?
  targetType String?
  targetId   String?
  summary    String
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  searchText String       @db.Text
  actor      User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([occurredAt(sort: Desc), id(sort: Desc)])
  @@index([actorId, occurredAt(sort: Desc)])
  @@index([outcome, occurredAt(sort: Desc)])
  @@index([event, occurredAt(sort: Desc)])
  @@index([page, occurredAt(sort: Desc)])
  @@index([targetType, targetId, occurredAt(sort: Desc)])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "audit_logs_search_text_trgm_idx")
  @@map("audit_logs")
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum SaleStatus {
  COMPLETED
  REFUNDED
  VOIDED
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE
}

enum RegisterOrderStatus {
  HELD
  COMPLETED
  CREDITED
  CANCELLED
}

enum BillStatus {
  UNPAID
  PAID
  AMENDED
  REVERSED
  CANCELLED
}

enum BillRevisionKind {
  INITIAL_PRINT
  REPRINT
  AMENDMENT
  REVERSAL
  CREDIT_ISSUED
  PAYMENT
  CANCELLATION
}

enum InventoryMovementType {
  INITIAL
  ADJUSTMENT
  SALE
  REFUND
}

enum ProductKind {
  GOODS
  CONSUMABLE
}

enum RegisterPurpose {
  SHOP
  RESTAURANT
}

enum CustomerCreditStatus {
  OUTSTANDING
  PAID
  CANCELLED
  REVERSED
}

model Product {
  id                 String               @id @default(uuid()) @db.Uuid
  registerId         String               @db.Uuid
  categoryId         String               @db.Uuid
  sku                String               @unique
  barcode            String?              @unique
  name               String
  category           String
  description        String?
  retailPriceLaari   Int
  costPriceLaari     Int                  @default(0)
  lowStockThreshold  Int                  @default(10)
  kind               ProductKind          @default(GOODS)
  quantityMetric     String?
  quantityValue      Decimal?             @db.Decimal(12, 3)
  servingSize        Decimal?             @db.Decimal(12, 3)
  searchText         String               @default("") @db.Text
  active             Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  register           CashRegister         @relation(fields: [registerId], references: [id], onDelete: Restrict)
  categoryRecord     ProductCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  saleItems          SaleItem[]
  stockMovements     InventoryMovement[]
  batches            InventoryBatch[]
  menuIngredients    MenuItemIngredient[]
  registerOrderItems RegisterOrderItem[]
  saleItemComponents SaleItemStockComponent[]
  inventoryConsumptions InventoryConsumption[]

  @@index([active, updatedAt(sort: Desc)])
  @@index([registerId, active, name])
  @@index([category])
  @@index([categoryId])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_search_text_trgm_idx")
  @@map("products")
}

model ProductCategory {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String    @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  products       Product[]

  @@index([name])
  @@map("product_categories")
}

model CashRegister {
  id                  String               @id @default(uuid()) @db.Uuid
  code                String               @unique
  name                String               @unique
  purpose             RegisterPurpose      @default(SHOP)
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  shifts              RegisterShift[]
  products            Product[]
  stockMovements      InventoryMovement[]
  menuItems           MenuItem[]
  restaurantTables    RestaurantTable[]
  customerCreditBills CustomerCreditBill[]
  batches             InventoryBatch[]
  roleAccess          RoleRegisterAccess[]

  @@index([active, name])
  @@map("cash_registers")
}

model RestaurantTable {
  id         String          @id @default(uuid()) @db.Uuid
  registerId String          @db.Uuid
  name       String
  seats      Int
  active     Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  register   CashRegister    @relation(fields: [registerId], references: [id], onDelete: Restrict)
  orders     RegisterOrder[]

  @@unique([registerId, name])
  @@index([registerId, active, name])
  @@map("restaurant_tables")
}

model Customer {
  id               String               @id @default(uuid()) @db.Uuid
  name             String
  email            String?
  address          String?
  phoneNumber      String?
  nationality      String
  creditLimitLaari Int
  active           Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  creditBills      CustomerCreditBill[]

  @@index([active, name])
  @@index([email])
  @@index([phoneNumber])
  @@map("customers")
}

model MenuItem {
  id                 String               @id @default(uuid()) @db.Uuid
  registerId         String               @db.Uuid
  name               String
  category           String
  retailPriceLaari   Int
  active             Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  register           CashRegister         @relation(fields: [registerId], references: [id], onDelete: Restrict)
  ingredients        MenuItemIngredient[]
  saleItems          SaleItem[]
  registerOrderItems RegisterOrderItem[]

  @@unique([registerId, name])
  @@index([registerId, active, name])
  @@map("menu_items")
}

model MenuItemIngredient {
  menuItemId        String   @db.Uuid
  productId         String   @db.Uuid
  servingMultiplier Int
  standalone        Boolean  @default(false)
  menuItem          MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([menuItemId, productId])
  @@index([productId])
  @@map("menu_item_ingredients")
}

model InventoryBatch {
  id                String       @id @default(uuid()) @db.Uuid
  productId         String       @db.Uuid
  registerId        String       @db.Uuid
  receivedById      String
  receivedQuantity  Decimal      @db.Decimal(14, 3)
  remainingQuantity Decimal      @db.Decimal(14, 3)
  expiryDate        DateTime?    @db.Date
  receivedAt        DateTime     @default(now())
  product           Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  register          CashRegister @relation(fields: [registerId], references: [id], onDelete: Restrict)
  receivedBy        User         @relation("BatchReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  consumptions      InventoryConsumption[]

  @@index([registerId, expiryDate])
  @@map("inventory_batches")
}

model RegisterShift {
  id                 String               @id @default(uuid()) @db.Uuid
  registerId         String               @db.Uuid
  openedById         String
  closedById         String?
  status             ShiftStatus          @default(OPEN)
  openingCashLaari   Int                  @default(0)
  closingCashLaari   Int?
  openedAt           DateTime             @default(now())
  closedAt           DateTime?
  register           CashRegister         @relation(fields: [registerId], references: [id], onDelete: Restrict)
  openedBy           User                 @relation("ShiftOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  closedBy           User?                @relation("ShiftClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  sales              Sale[]
  bills              Bill[]
  registerOrders     RegisterOrder[]
  issuedCreditBills  CustomerCreditBill[] @relation("CreditBillIssuedShift")
  settledCreditBills CustomerCreditBill[] @relation("CreditBillSettledShift")

  @@index([registerId, status, openedAt(sort: Desc)])
  @@index([openedById])
  @@index([closedById])
  @@map("register_shifts")
}

model Sale {
  id                 String              @id @default(uuid()) @db.Uuid
  receiptNumber      BigInt              @unique @default(autoincrement())
  registerShiftId    String              @db.Uuid
  createdById        String
  status             SaleStatus          @default(COMPLETED)
  paymentMethod      PaymentMethod
  subtotalLaari      Int
  totalLaari         Int
  createdAt          DateTime            @default(now())
  refundedAt         DateTime?
  registerShift      RegisterShift       @relation(fields: [registerShiftId], references: [id], onDelete: Restrict)
  createdBy          User                @relation("SaleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items              SaleItem[]
  stockMovements     InventoryMovement[]
  registerOrder      RegisterOrder?
  bill               Bill?
  customerCreditBill CustomerCreditBill?
  inventoryConsumptions InventoryConsumption[]

  @@index([status, createdAt(sort: Desc)])
  @@index([registerShiftId, createdAt(sort: Desc)])
  @@index([createdById])
  @@map("sales")
}

model Bill {
  id                   String             @id @default(uuid()) @db.Uuid
  billNumber           BigInt             @unique @default(autoincrement())
  saleId               String?            @unique @db.Uuid
  orderId              String?            @unique @db.Uuid
  customerCreditBillId String?            @unique @db.Uuid
  registerShiftId      String             @db.Uuid
  receiptNumber        BigInt?            @unique
  status               BillStatus         @default(PAID)
  registerId           String             @db.Uuid
  registerName         String
  registerCode         String
  cashierName          String
  openedById           String
  openedByName         String
  paidById             String?
  paidByName           String?
  paymentMethod        PaymentMethod
  subtotalLaari        Int
  totalLaari           Int
  items                Json
  customerNote         String?
  restaurantTableId    String?            @db.Uuid
  restaurantTableName  String?
  openedAt             DateTime           @default(now())
  paidAt               DateTime?
  cancelledAt          DateTime?
  soldAt               DateTime?
  version              Int                @default(1)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  sale                 Sale?              @relation(fields: [saleId], references: [id], onDelete: Restrict)
  order                RegisterOrder?     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customerCreditBill   CustomerCreditBill? @relation(fields: [customerCreditBillId], references: [id], onDelete: Restrict)
  registerShift        RegisterShift      @relation(fields: [registerShiftId], references: [id], onDelete: Restrict)
  revisions            BillRevision[]

  @@index([openedAt(sort: Desc), id(sort: Desc)])
  @@index([registerId, openedAt(sort: Desc), id(sort: Desc)])
  @@index([registerShiftId, openedAt(sort: Desc), id(sort: Desc)])
  @@index([status, openedAt(sort: Desc)])
  @@index([paymentMethod, openedAt(sort: Desc)])
  @@map("bills")
}

model BillRevision {
  id        String           @id @default(uuid()) @db.Uuid
  billId    String           @db.Uuid
  revision  Int
  kind      BillRevisionKind
  actorId   String
  actorName String
  changes   Json
  snapshot  Json
  metadata  Json?
  createdAt DateTime         @default(now())
  bill      Bill             @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@unique([billId, revision])
  @@index([billId, createdAt])
  @@map("bill_revisions")
}

model CustomerCreditBill {
  id             String               @id @default(uuid()) @db.Uuid
  customerId     String               @db.Uuid
  registerId     String               @db.Uuid
  issuedShiftId  String               @db.Uuid
  createdById    String
  settledShiftId String?              @db.Uuid
  settledById    String?
  saleId         String?              @unique @db.Uuid
  status         CustomerCreditStatus @default(OUTSTANDING)
  subtotalLaari  Int
  totalLaari     Int
  items          Json
  note           String?
  issuedAt       DateTime             @default(now())
  paidAt         DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  customer       Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  register       CashRegister         @relation(fields: [registerId], references: [id], onDelete: Restrict)
  issuedShift    RegisterShift        @relation("CreditBillIssuedShift", fields: [issuedShiftId], references: [id], onDelete: Restrict)
  createdBy      User                 @relation("CreditBillCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  settledShift   RegisterShift?       @relation("CreditBillSettledShift", fields: [settledShiftId], references: [id], onDelete: Restrict)
  settledBy      User?                @relation("CreditBillSettledBy", fields: [settledById], references: [id], onDelete: Restrict)
  sale           Sale?                @relation(fields: [saleId], references: [id], onDelete: Restrict)
  stockMovements InventoryMovement[]
  bill           Bill?
  inventoryConsumptions InventoryConsumption[]

  @@index([customerId, status, issuedAt(sort: Desc)])
  @@index([registerId, status, issuedAt(sort: Desc)])
  @@index([issuedShiftId])
  @@index([settledShiftId])
  @@index([createdById])
  @@index([settledById])
  @@map("customer_credit_bills")
}

model SaleItem {
  id             String    @id @default(uuid()) @db.Uuid
  saleId         String    @db.Uuid
  productId      String?   @db.Uuid
  menuItemId     String?   @db.Uuid
  productName    String
  productSku     String?
  itemCategory   String
  quantity       Int
  unitPriceLaari Int
  lineTotalLaari Int
  sale           Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product        Product?  @relation(fields: [productId], references: [id], onDelete: Restrict)
  menuItem       MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  stockComponents SaleItemStockComponent[]
  inventoryConsumptions InventoryConsumption[]

  @@index([saleId])
  @@index([productId])
  @@index([menuItemId])
  @@map("sale_items")
}

model SaleItemStockComponent {
  saleItemId      String   @db.Uuid
  productId       String   @db.Uuid
  measuredPerItem Decimal  @db.Decimal(14, 3)
  saleItem        SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([saleItemId, productId])
  @@index([productId])
  @@map("sale_item_stock_components")
}

model RegisterOrder {
  id                String              @id @default(uuid()) @db.Uuid
  registerShiftId   String              @db.Uuid
  createdById       String
  saleId            String?             @unique @db.Uuid
  restaurantTableId String?             @db.Uuid
  status            RegisterOrderStatus @default(HELD)
  customerNote      String?
  paymentMethod     PaymentMethod?
  subtotalLaari     Int
  totalLaari        Int
  heldAt            DateTime            @default(now())
  completedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  registerShift     RegisterShift       @relation(fields: [registerShiftId], references: [id], onDelete: Restrict)
  createdBy         User                @relation("RegisterOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  sale              Sale?               @relation(fields: [saleId], references: [id], onDelete: SetNull)
  restaurantTable   RestaurantTable?    @relation(fields: [restaurantTableId], references: [id], onDelete: Restrict)
  items             RegisterOrderItem[]
  bill              Bill?

  @@index([registerShiftId, status, heldAt(sort: Desc)])
  @@index([createdById])
  @@index([restaurantTableId, status])
  @@map("register_orders")
}

model RegisterOrderItem {
  id             String        @id @default(uuid()) @db.Uuid
  orderId        String        @db.Uuid
  productId      String?       @db.Uuid
  menuItemId     String?       @db.Uuid
  productName    String
  productSku     String?
  itemCategory   String
  quantity       Int
  unitPriceLaari Int
  lineTotalLaari Int
  order          RegisterOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product?      @relation(fields: [productId], references: [id], onDelete: Restrict)
  menuItem       MenuItem?     @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@index([menuItemId])
  @@map("register_order_items")
}

model InventoryMovement {
  id                   String                @id @default(uuid()) @db.Uuid
  productId            String                @db.Uuid
  registerId           String                @db.Uuid
  saleId               String?               @db.Uuid
  customerCreditBillId String?               @db.Uuid
  createdById          String
  type                 InventoryMovementType
  quantityDelta        Decimal               @db.Decimal(14, 3)
  balanceAfter         Decimal               @db.Decimal(14, 3)
  reason               String?
  searchText           String                @default("") @db.Text
  createdAt            DateTime              @default(now())
  product              Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  register             CashRegister          @relation(fields: [registerId], references: [id], onDelete: Restrict)
  sale                 Sale?                 @relation(fields: [saleId], references: [id], onDelete: Restrict)
  customerCreditBill   CustomerCreditBill?   @relation(fields: [customerCreditBillId], references: [id], onDelete: Restrict)
  createdBy            User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  consumptions         InventoryConsumption[]

  @@index([productId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([registerId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([type, createdAt(sort: Desc), id(sort: Desc)])
  @@index([saleId])
  @@index([customerCreditBillId])
  @@index([createdById])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "inventory_movements_search_text_trgm_idx")
  @@map("inventory_movements")
}

model InventoryConsumption {
  id                   String              @id @default(uuid()) @db.Uuid
  sourceLineId         String              @db.Uuid
  saleId               String?             @db.Uuid
  saleItemId           String?             @db.Uuid
  customerCreditBillId String?             @db.Uuid
  inventoryMovementId  String              @db.Uuid
  productId            String              @db.Uuid
  batchId              String              @db.Uuid
  consumedQuantity     Decimal             @db.Decimal(14, 3)
  restoredQuantity     Decimal             @default(0) @db.Decimal(14, 3)
  retiredQuantity      Decimal             @default(0) @db.Decimal(14, 3)
  createdAt            DateTime            @default(now())
  sale                 Sale?               @relation(fields: [saleId], references: [id], onDelete: Restrict)
  saleItem             SaleItem?           @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  customerCreditBill   CustomerCreditBill? @relation(fields: [customerCreditBillId], references: [id], onDelete: Restrict)
  inventoryMovement    InventoryMovement   @relation(fields: [inventoryMovementId], references: [id], onDelete: Restrict)
  product              Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch                InventoryBatch      @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([sourceLineId])
  @@index([saleId])
  @@index([saleItemId])
  @@index([customerCreditBillId])
  @@index([inventoryMovementId])
  @@index([productId])
  @@index([batchId])
  @@map("inventory_consumptions")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
